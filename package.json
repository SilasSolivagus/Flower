{
  "name": "flower",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": { "node": ">=22" },
  "scripts": {
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "typecheck": "pnpm -r typecheck",
    "dev": "pnpm --filter @flower/web dev",
    "db:migrate": "pnpm --filter @flower/core db:migrate",
    "ux-seed:batch2": "pnpm --filter @flower/core exec esbuild ../../scripts/ux-seed-batch2.ts --bundle --platform=node --format=esm --target=node22 --outfile=../../.local-data/ux-seed-batch2.mjs --external:@node-rs/argon2 --external:satori --external:@resvg/resvg-js --banner:js=\"import{createRequire}from'module';const require=createRequire(import.meta.url);\" && node --disable-warning=ExperimentalWarning --env-file=apps/web/.env.local .local-data/ux-seed-batch2.mjs"
  }
}
