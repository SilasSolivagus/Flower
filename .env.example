# 本地开发专用（配合 docker-compose.dev.yml），复制为 apps/web/.env.local
DATABASE_URL=postgres://flower_app:flower_app_dev@localhost:54329/flower
DATABASE_ADMIN_URL=postgres://flower_admin:flower_admin@localhost:54329/flower
FLOWER_APP_DB_PASSWORD=flower_app_dev
# 用 openssl rand -base64 48 生成
FLOWER_SECRET_KEY=
FLOWER_PUBLIC_URL=http://localhost:3000
# 前面反向代理的层数，用于从 X-Forwarded-For 取真实 IP（默认 0，即不信任该请求头）
FLOWER_TRUSTED_PROXY_HOPS=0
# PRD 图片附件的存放目录（缺省为进程工作目录下的 .flower-storage，开发时即 apps/web/.flower-storage）
# FLOWER_STORAGE_DIR=
# 推送后台发送循环：默认随应用启动；设为 off 时不启动（测试与端到端用）
# FLOWER_NOTIFY_WORKER=off
# 设为 1 时开放 POST /api/v1/instance/notifications/tick（实例管理员手动驱动一轮，仅测试用）
# FLOWER_NOTIFY_TICK_API=1
