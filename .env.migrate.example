# 只挂给 schema / migrate。变更窗口内才存在，权限 600，用完即删，不进仓库。
# prd-src 不读本文件。另建 .env.prdsrc（权限 600，用完即删），里面只有一行 POSTGRES_PASSWORD。
# LEGACY_PRD_URL 的密码必须和那一行相同。密码只用字母和数字。
DATABASE_ADMIN_URL=postgres://flower_admin:<POSTGRES_ADMIN_PASSWORD>@postgres:5432/flower
FLOWER_APP_DB_PASSWORD=
DATABASE_URL=postgres://flower_app:<FLOWER_APP_DB_PASSWORD>@postgres:5432/flower
FLOWER_SECRET_KEY=
POSTGRES_PASSWORD=
LEGACY_PRD_URL=postgres://postgres:<POSTGRES_PASSWORD>@prd-src:5432/prd_src
