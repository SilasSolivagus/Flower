# 自托管部署专用（docker-compose.yml），复制为 .env；密码请只用字母和数字（会拼进数据库连接串）
POSTGRES_ADMIN_PASSWORD=
# openssl rand -hex 24
FLOWER_APP_DB_PASSWORD=
# openssl rand -base64 48
FLOWER_SECRET_KEY=
FLOWER_PUBLIC_URL=http://localhost:3000
FLOWER_PORT=3000
# 前面反向代理的层数，用于从 X-Forwarded-For 取真实 IP（默认 0，即不信任该请求头）
FLOWER_TRUSTED_PROXY_HOPS=0
